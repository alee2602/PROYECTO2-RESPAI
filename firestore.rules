rules_version = '2';

// Dueño: Rol 4 (Datos y relevancia). Cualquier cambio se avisa al equipo antes
// de desplegarlo (ver docs/roles-equipo.md, regla 2).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Quién es admin se decide con DATOS, no con código (así ningún correo
    // de compañero queda escrito en el repo). Un correo es admin si existe
    // un documento admins/{correo} en Firestore. Esos documentos se crean a
    // mano desde Firebase Console → Firestore → Data (nadie puede crearlos
    // ni borrarlos desde el cliente, ver reglas de /admins más abajo).
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // Una persona solo puede leer SU PROPIO documento de admin (para que el
    // portal sepa qué pantalla mostrarle) — nunca la lista completa de
    // correos admin, eso seguiría siendo visible solo desde Firebase Console.
    match /admins/{email} {
      allow read: if isSignedIn() && request.auth.token.email == email;
      allow write: if false;
    }

    // News: cualquier usuario logueado puede leer. Solo admins pueden
    // publicar, editar o borrar (criterio humano, nunca el código ni un modelo).
    match /news/{newsId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Perfil del usuario (ubicación simulada, intereses inferidos): solo su dueño.
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;

      // Señales de comportamiento (abrir, tiempo de lectura, compartir): solo su dueño.
      match /signals/{signalId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Medidor de gasto del chat (Rol 5, docs/medidor-gasto.md). Lo escribe
    // solo el servidor con el Admin SDK, que no pasa por estas reglas. Desde
    // el cliente: solo admins leen (tablero del portal).
    match /usage/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /rate_limits/{userId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Interruptor y reserva del chat: los cambia un admin desde el tablero
    // /costos. El endpoint solo lo apaga (Admin SDK, no pasa por acá).
    // Se valida el formato para que un error del portal no deje un documento
    // que confunda al endpoint. Contrato: docs/medidor-gasto.md.
    match /config/chat {
      allow read: if isAdmin();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(["enabled", "reserveUsd", "disabledBy", "updatedAt"])
        && (!("enabled" in request.resource.data) || request.resource.data.enabled is bool)
        && (!("reserveUsd" in request.resource.data)
            || (request.resource.data.reserveUsd is number
                && request.resource.data.reserveUsd >= 0
                && request.resource.data.reserveUsd <= 20))
        && (!("disabledBy" in request.resource.data)
            || request.resource.data.disabledBy == null
            || request.resource.data.disabledBy in ["admin", "reserve"]);
    }

    // Todo lo demás, cerrado por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
