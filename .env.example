# Config de Firebase (proyecto: respai-news-app) — NO es secreta, pero va en variables
# de entorno para no hardcodearla y poder cambiar de proyecto sin tocar código.
# Cuando se decida el framework del frontend (Next.js, Vite, etc.), renombrar estas
# claves con el prefijo que ese framework exija para exponerlas al cliente
# (ej. Next.js: NEXT_PUBLIC_FIREBASE_API_KEY; Vite: VITE_FIREBASE_API_KEY).

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# La API key del modelo de IA para el chat NUNCA va aquí con un prefijo público —
# esa vive solo del lado del servidor (función de Vercel), sin exponerse al cliente.
